# DigitalOcean Inference API key (doo_v1_...)
DO_API_KEY=

# Secret key to authenticate requests to this proxy
# Generated automatically by install.sh — do not share
PROXY_SECRET=

# Internal port the Nginx proxy listens on
PORT=4040

# Optional: domain name (leave empty if using bare IP)
HOST=

# Optional: paths to Cloudflare origin certificate files
SSL_CERT=
SSL_KEY=
